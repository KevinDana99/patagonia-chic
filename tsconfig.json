{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react",
		"module": "ESNext",
		"declaration": false,
		"sourceMap": true,
		"outDir": "dist",
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
	},
	"exclude": [
		"dist",
		"node_modules",
		"src/**/*.test.tsx",
		"src/**/*.stories.tsx"
	]
}
